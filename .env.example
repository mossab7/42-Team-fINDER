# Register a read-only application at https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Add ${PUBLIC_BASE_URL}/api/auth/callback as this application's Redirect URI
# in the 42 profile portal before enabling AUTH_REQUIRED.
PUBLIC_BASE_URL=http://localhost:3000
AUTH_REQUIRED=false
SESSION_TTL_HOURS=24
# Set true only when PUBLIC_BASE_URL uses HTTPS.
SESSION_COOKIE_SECURE=false
DATABASE_URL=sqlite+aiosqlite:////app/data/team_finder.db
CACHE_TTL_SECONDS=3600
FRONTEND_PORT=3000
# Public listener ports (the optional Caddy public profile terminates TLS).
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGINS=http://localhost:3000
# Downloaded 42 avatars are stored here and refreshed daily.
AVATAR_CACHE_DIRECTORY=/app/data/avatars
AVATAR_CACHE_TTL_SECONDS=86400
# Pace concurrent pagination below 42's burst/spam threshold.
API_CONCURRENCY=4
API_MIN_INTERVAL_SECONDS=0.6
# Leave blank to auto-enable demo fixtures when credentials are absent.
# Set true or false explicitly to override automatic behavior.
DEMO_MODE=
